{
  "functions": {
    "api/generate-hooks.ts": {
      "maxDuration": 60
    },
    "api/rewrite-hook.ts": {
      "maxDuration": 60
    },
    "api/debug.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ]
}


# ==========================================
# VIRALITY AI ENVIRONMENT VARIABLES
# ==========================================

# ------------------------------------------
# REQUIRED (at least one key)
# ------------------------------------------

# Gemini API Keys — the backend rotates through these automatically.
# If one key hits the rate limit (429), it tries the next key instantly.
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=

# ------------------------------------------
# OPTIONAL (Vite Frontend Configuration)
# ------------------------------------------

# Supabase Auth Configuration (Soft Auth)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

